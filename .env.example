# Client (Vite, öffentlich im Browser-Bundle sichtbar)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel Functions unter /api, NIEMALS mit VITE_-Prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Öffentliche URL der App, z. B. https://mrh-coaching.vercel.app (ohne "/" am Ende)
# Wird für den Einladungslink verwendet (Redirect direkt zu /passwort-festlegen).
# Ohne gesetztes APP_URL wird die URL ersatzweise aus dem Host-Header des
# Requests abgeleitet -- explizit setzen ist trotzdem empfohlen (siehe README).
# Muss in Supabase unter Auth > URL Configuration > Site URL + Redirect URLs
# eingetragen sein, siehe README-Abschnitt "APP_URL korrekt setzen".
APP_URL=

# Stripe (Phase 2: Self-Signup & Zahlung), alle server-only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Testergebnisse-Verknüpfung: eingeschränkter Lesezugriff auf das separate
# Profil-Quiz-Projekt, server-only. Siehe README-Abschnitt "Testergebnisse".
# PROFIL_QUIZ_ANON_KEY ist der normale (öffentliche) anon/publishable Key
# des Profil-Quiz-Projekts -- nur fürs API-Gateway, bestimmt keine Rolle.
# PROFIL_QUIZ_READER_TOKEN ist das separat gemintete Reader-JWT, das die
# eigentliche Zugriffsbeschränkung durchsetzt (Postgres-Rolle).
PROFIL_QUIZ_URL=https://rbfsfcetdzdsyoffglwi.supabase.co
PROFIL_QUIZ_ANON_KEY=
PROFIL_QUIZ_READER_TOKEN=
