# Client (Vite, öffentlich im Browser-Bundle sichtbar)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel Functions unter /api, NIEMALS mit VITE_-Prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Öffentliche URL der App, z. B. https://mrh-coaching.vercel.app
# Wird für den Einladungslink verwendet (Redirect direkt zu /passwort-festlegen).
# Muss in Supabase unter Auth > URL Configuration > Redirect URLs eingetragen sein.
APP_URL=
