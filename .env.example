# Client (Vite, öffentlich im Browser-Bundle sichtbar)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel Functions unter /api, NIEMALS mit VITE_-Prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Öffentliche URL der App, z. B. https://mrh-coaching.vercel.app (ohne "/" am Ende)
# Wird für den Einladungslink verwendet (Redirect direkt zu /passwort-festlegen).
# Ohne gesetztes APP_URL wird die URL ersatzweise aus dem Host-Header des
# Requests abgeleitet -- explizit setzen ist trotzdem empfohlen (siehe README).
# Muss in Supabase unter Auth > URL Configuration > Site URL + Redirect URLs
# eingetragen sein, siehe README-Abschnitt "APP_URL korrekt setzen".
APP_URL=

# Stripe (Phase 2: Self-Signup & Zahlung), alle server-only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
