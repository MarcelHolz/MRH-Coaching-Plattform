# Client (Vite, öffentlich im Browser-Bundle sichtbar)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel Functions unter /api, NIEMALS mit VITE_-Prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Öffentliche URL der App, z. B. https://mrh-coaching.vercel.app (ohne "/" am Ende)
# Wird für den Einladungslink verwendet (Redirect direkt zu /passwort-festlegen).
# Ohne gesetztes APP_URL wird die URL ersatzweise aus dem Host-Header des
# Requests abgeleitet -- explizit setzen ist trotzdem empfohlen (siehe README).
# Muss in Supabase unter Auth > URL Configuration > Site URL + Redirect URLs
# eingetragen sein, siehe README-Abschnitt "APP_URL korrekt setzen".
APP_URL=

# Stripe (Phase 2: Self-Signup & Zahlung), alle server-only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Testergebnisse-Verknüpfung: eingeschränkter Lesezugriff auf das separate
# Profil-Quiz-Projekt, server-only. Siehe README-Abschnitt "Testergebnisse".
# PROFIL_QUIZ_READER_SECRET ist ein selbst frei vergebenes Secret (z. B.
# per "node -e console.log(require('crypto').randomBytes(32).toString('hex'))"
# erzeugt) -- derselbe Wert muss als READER_SECRET auf der dort deployten
# Edge Function (profil-quiz-edge-function/) gesetzt sein.
PROFIL_QUIZ_URL=https://rbfsfcetdzdsyoffglwi.supabase.co
PROFIL_QUIZ_READER_SECRET=

# Erinnerungsautomation bei Inaktivität (Punkt 2), server-only.
# CRON_SECRET: selbst frei vergebenes Secret (z. B. per
# "node -e console.log(require('crypto').randomBytes(32).toString('hex'))"
# erzeugt). Vercel schickt bei jedem Cron-Aufruf automatisch den Header
# "Authorization: Bearer $CRON_SECRET" -- api/cron/erinnerungen.js prüft
# das gegen denselben Wert.
CRON_SECRET=
# SMTP-Zugangsdaten für den Versand der Erinnerungsmail (All-Inkl-Postfach
# info@mrh-beratung.de). Getrennt von den Supabase-Auth-Mails (Einladung/
# Passwort-Reset), da deren Vorlagen keinen freien Inhalt erlauben.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@mrh-beratung.de

# Produktagent (eigenständige Kursanlage als Entwurf), server-only.
# AGENT_CONTENT_SECRET: selbst frei vergebenes Secret (z. B. per
# "node -e console.log(require('crypto').randomBytes(32).toString('hex'))"
# erzeugt) -- derselbe Wert muss der Agent bei jedem Request als Header
# "x-agent-secret" mitschicken. Siehe README-Abschnitt "Produktagent".
AGENT_CONTENT_SECRET=

# Calendly-Webhook (1:1-Sitzungen aus Kurspaket zählen), server-only.
# CALENDLY_WEBHOOK_SECRET: das Signing Secret der Webhook-Subscription
# (wird beim Anlegen über die Calendly-API zurückgegeben, siehe
# README-Abschnitt "Calendly-Buchungszählung") -- api/webhooks/calendly.js
# prüft damit den Header "Calendly-Webhook-Signature".
CALENDLY_WEBHOOK_SECRET=
# CALENDLY_PAT: Personal Access Token aus dem Calendly-Account (Integrations
# > API & Webhooks). Wird zum einmaligen Anlegen der Webhook-Subscription
# gebraucht (siehe README) und optional zur Laufzeit, falls die
# Webhook-Payload die scheduling_url nicht direkt enthält und
# api/webhooks/calendly.js sie per Calendly-API nachladen muss.
CALENDLY_PAT=
